<section class="search-v2-section">
    
    <!-- Barre de Recherche Principale (Quoi / Où / Rechercher) -->
    <div class="search-hero-wrapper">
        <div class="container">
            <div class="search-container-inner">
                <h1 class="search-hero-title-text">
                    {% if hero_title %}
                        {{hero_title}}
                    {% endif %}
                </h1>
                {% if hero_subtitle %}
                    <p class="search-hero-subtitle">
                        {{hero_subtitle}}
                    </p>
                {% endif %}
                
                <form id="main-search-form" class="search-main-form" 
                      hx-get="/SearchUi" 
                      hx-target="#SearchUi-home-wrapper" 
                      hx-select="#SearchUi-home-wrapper" 
                      hx-swap="outerHTML"
                      hx-push-url="true"
                      hx-indicator="#loading-overlay"
                      hx-trigger="submit, keyup changed delay:200ms from:#main-search">
                    
                    <!-- Quoi -->
                    <div class="search-input-group-query">
                        <i class="fa-solid fa-search search-icon-query"></i>
                        <input type="text" 
                               id="main-search" 
                               name="query" 
                               value="{{query}}" 
                               placeholder="Qu'est-ce que vous cherchez ? (Ex: Restaurant, Coiffeur...)" 
                               class="search-input-field">
                    </div>

                    <!-- Où -->
                    <div class="search-input-group-location">
                        <i class="fa-solid fa-location-dot search-icon-location"></i>
                        <select name="city" id="main-city-select" 
                                hx-get="/SearchUi" 
                                hx-target="#SearchUi-home-wrapper" 
                                hx-select="#SearchUi-home-wrapper" 
                                hx-swap="outerHTML"
                                hx-trigger="change"
                                class="search-select-city">
                            <option value="">Bourges (Agglo)</option>
                            {% for city in agglo_cities %}
                                <option value="{{city.name}}" {% if selected_city == city.name %}selected{% endif %}>
                                    {{city.name}}
                                </option>
                            {% endfor %}
                        </select>
                        <button type="button" id="locate-me-btn" title="Utiliser ma position" class="search-locate-btn">
                            <i class="fa-solid fa-crosshairs"></i>
                        </button>
                    </div>

                    <!-- Bouton Rechercher -->
                    <button type="submit" class="search-submit-btn">
                        <span>Rechercher</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </form>

                {% for section in extraHomeSections %}
                    {% if 'blog-latest-post' not in section %}
                        <div class="home-section-extra" style="margin-top: 20px;">
                            {{ section|raw }}
                        </div>
                    {% endif %}
                {% endfor %}

            </div>
        </div>
    </div>

    <!-- Barre de Statut & Filtres (Collé sous le Hero) -->
    <div class="container relative-container search-filter-bar-container">
        <div class="search-container-inner">
            <!-- État de la Recherche (OOB Swap) -->
            <div id="search-status-bar" hx-swap-oob="true" class="search-status-bar">
                
                <button type="button" id="toggle-sidebar-btn" class="search-filter-toggle-btn {% if filter_map or selected_family or around_me or only_open or claimed or filters_open %}active{% endif %}" onclick="toggleFilters()">
                    <i class="fa-solid fa-filter"></i> <span class="btn-text">Filtres</span>
                </button>

                {% if CORE.callHook('map:is-enabled') %}
                <button type="button" id="toggle-map-btn" class="search-map-toggle-btn">
                    <i class="fa-solid fa-map"></i> <span class="btn-text">Carte</span>
                </button>
                {% endif %}

                <a href="{{SHOW.siteUrl}}/recherche" 
                   hx-get="/SearchUi" 
                   hx-target="#SearchUi-home-wrapper" 
                   hx-select="#SearchUi-home-wrapper" 
                   hx-swap="outerHTML"
                   hx-push-url="true"
                   hx-indicator="#loading-overlay"
                   class="search-reset-link">
                    <i class="fa-solid fa-rotate-right"></i> <span class="btn-text">Réinitialiser</span>
                </a>
                
                <div class="search-separator"></div>

                <span class="search-results-label">Résultats :</span>
                
                <div id="active-badges" class="search-active-badges">
                    {% if query %}
                        <div class="search-badge search-badge-query">
                            <span>"{{query}}"</span>
                            <i class="fa-solid fa-times search-badge-remove" onclick="document.getElementById('main-search').value=''; document.getElementById('main-search-form').dispatchEvent(new Event('submit'));"></i>
                        </div>
                    {% endif %}

                    {% if selected_city %}
                        <div class="search-badge search-badge-city">
                            <i class="fa-solid fa-location-dot" style="font-size: 0.75rem;"></i>
                            <span>{{selected_city}}</span>
                            <i class="fa-solid fa-times search-badge-remove" onclick="document.getElementById('main-city-select').value=''; document.getElementById('main-search-form').dispatchEvent(new Event('submit'));"></i>
                        </div>
                    {% endif %}

                    {% if selected_family %}
                        <div class="search-badge search-badge-family">
                            <i class="fa-solid fa-tag" style="font-size: 0.75rem;"></i>
                            <span>{% if selected_family_label %}{{selected_family_label}}{% else %}{{selected_family}}{% endif %}</span>
                            <i class="fa-solid fa-times search-badge-remove" onclick="document.getElementById('family-select').value=''; document.getElementById('filter-form').dispatchEvent(new Event('submit'));"></i>
                        </div>
                    {% endif %}

                    {% if selected_subcategory %}
                        <div class="search-badge search-badge-subcat">
                            <i class="fa-solid fa-tags" style="font-size: 0.75rem;"></i>
                            <span>{% if selected_subcategory_label %}{{selected_subcategory_label}}{% else %}{{selected_subcategory}}{% endif %}</span>
                            <i class="fa-solid fa-times search-badge-remove" onclick="document.getElementById('subcategory-select').value=''; document.getElementById('filter-form').dispatchEvent(new Event('submit'));"></i>
                        </div>
                    {% endif %}

                    {% if around_me %}
                        <div class="search-badge search-badge-radius">
                            <i class="fa-solid fa-location-crosshairs" style="font-size: 0.75rem;"></i>
                            <span>Rayon {{radius}}km</span>
                            <i class="fa-solid fa-times search-badge-remove" onclick="document.getElementById('around-me-checkbox').checked=false; document.getElementById('filter-form').dispatchEvent(new Event('submit'));"></i>
                        </div>
                    {% endif %}

                    {% if only_open %}
                        <div class="search-badge search-badge-open">
                            <i class="fa-solid fa-clock" style="font-size: 0.75rem;"></i>
                            <span>Ouvert uniquement</span>
                            <i class="fa-solid fa-times search-badge-remove" onclick="document.getElementById('only-open-checkbox').checked=false; document.getElementById('filter-form').dispatchEvent(new Event('submit'));"></i>
                        </div>
                    {% endif %}

                    {% if claimed %}
                        <div class="search-badge search-badge-verified">
                            <i class="fa-solid fa-check-circle" style="font-size: 0.75rem;"></i>
                            <span>Lieux vérifiés</span>
                            <i class="fa-solid fa-times search-badge-remove" onclick="document.getElementById('claimed-checkbox').checked=false; document.getElementById('filter-form').dispatchEvent(new Event('submit'));"></i>
                        </div>
                    {% endif %}
                </div>

                <div class="search-results-count">
                    {{filtered_results_count}} <span style="font-size: 0.8rem; text-transform: uppercase;">lieux</span>
                </div>
            </div>

            <!-- Bloc Filtres Horizontal (Anciennement Sidebar) -->
            <div id="search-filters-bar" hx-swap-oob="true" class="search-filters-bar {% if not (filter_map or selected_family or around_me or only_open or claimed or filters_open) %}search-hidden{% endif %}">
                <form id="filter-form" action="/SearchUi" method="GET" 
                      hx-get="/SearchUi" 
                      hx-target="#SearchUi-home-wrapper" 
                      hx-select="#SearchUi-home-wrapper" 
                      hx-swap="outerHTML"
                      hx-push-url="true"
                      hx-trigger="submit, change delay:500ms, input delay:500ms" 
                      hx-indicator="#loading-overlay"
                      class="search-filters-form">
                    
                    <!-- Inputs cachés Géoloc & Pagination & Query/City persist -->
                    <input type="hidden" name="query" value="{{query}}">
                    <input type="hidden" name="city" value="{{selected_city}}">
                    <input type="hidden" name="offset" value="0">
                    <input type="hidden" name="limit" value="{{limit}}">
                    <input type="hidden" id="user-lat" name="user_lat" value="{{user_lat}}">
                    <input type="hidden" id="user-lon" name="user_lon" value="{{user_lon}}">
                    <input type="hidden" id="filters-open-state" name="filters_open" value="{{filters_open}}">

                    <!-- Famille -->
                    <div class="search-filter-select-wrapper">
                        <select id="family-select" name="family" class="search-filter-select" autocomplete="off">
                            <option value="">Toutes les activités</option>
                            {% for act in activities %}
                                <option value="{{act.key}}" {% if selected_family == act.key %}selected{% endif %}>
                                    {{act.label}} ({{act.count}})
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <!-- Sous-catégorie -->
                    {% if selected_family and family_subcategories %}
                    <div class="search-filter-select-wrapper">
                        <select id="subcategory-select" name="subcategory" class="search-filter-select" autocomplete="off">
                            <option value="">Toutes les spécialités</option>
                            {% for sub in family_subcategories %}
                                <option value="{{sub.key}}" {% if selected_subcategory == sub.key %}selected{% endif %}>
                                    {{sub.label}} ({{sub.count}})
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    {% endif %}

                    <!-- Rayon -->
                    <div class="search-filter-radius-group" autocomplete="off">
                        <label class="search-radius-label">
                            <input type="checkbox" id="around-me-checkbox" name="around_me" value="1" {% if around_me %}checked{% endif %} class="search-filter-checkbox" autocomplete="off">
                            <i class="fa-solid fa-location-crosshairs" style="color: #ff8c42;"></i>
                        </label>
                        <div id="radius-slider-group" class="search-slider-container {% if not around_me %}search-step-disabled{% endif %}">
                            <input type="range" id="radius-slider" name="radius" min="1" max="50" step="1" value="{{radius}}" class="search-range-input" autocomplete="off">
                            <span class="search-radius-value-wrapper"><span id="radius-value">{{radius}}</span>km</span>
                        </div>
                    </div>

                    <!-- Checkboxes -->
                    <div class="search-checkbox-group">
                        <label class="search-filter-checkbox-label">
                            <input type="checkbox" id="only-open-checkbox" name="only_open" value="1" {% if only_open %}checked{% endif %} class="search-filter-checkbox" autocomplete="off">
                            Ouvert
                        </label>
                        <label class="search-filter-checkbox-label">
                            <input type="checkbox" id="claimed-checkbox" name="claimed" value="1" {% if claimed %}checked{% endif %} class="search-filter-checkbox" autocomplete="off">
                            Vérifié
                        </label>
                    </div>

                    <!-- Checkboxes Labels removed for brevity -->
                </form>
            </div>
        </div>
    </div>

    <!-- Section Hook : Injections plugins (Blog, CTAs, etc.) déplacé en haut -->




    <!-- Carte Leaflet (DÉPLACÉE PLUS BAS DANS LE MAIN-SEARCH) -->

<script>
function toggleFilters() {
    var filtersBar = document.getElementById('search-filters-bar');
    var openState = document.getElementById('filters-open-state');
    var btn = document.getElementById('toggle-sidebar-btn');
    
    if (filtersBar) {
        if (filtersBar.classList.contains('search-hidden')) {
            filtersBar.classList.remove('search-hidden');
            if(openState) openState.value = '1';
            if(btn) btn.classList.add('active');
        } else {
            filtersBar.classList.add('search-hidden');
            if(openState) openState.value = '';
            if(btn) btn.classList.remove('active');
        }
    }
}

// === CARTE PLEIN ÉCRAN (mobile) ===
function toggleMapFullscreen() {
    var container = document.getElementById('home-map-container');
    var icon = document.getElementById('map-fullscreen-icon');
    if (!container) return;
    var isFullscreen = container.classList.toggle('map-fullscreen-active');
    if (icon) {
        icon.className = isFullscreen ? 'fa-solid fa-compress' : 'fa-solid fa-expand';
    }
    // Forcer Leaflet à recalculer la taille de la carte
    setTimeout(function() {
        if (window.HomeMapMinimal && window.HomeMapMinimal.invalidateSize) {
            window.HomeMapMinimal.invalidateSize();
        }
    }, 300);
    // Bloquer le scroll du body quand plein écran
    document.body.style.overflow = isFullscreen ? 'hidden' : '';
}

// === BOUTON FERMETURE LÉGENDE LEAFLET ===
document.addEventListener('DOMContentLoaded', function() {
    // On attend que Leaflet ait rendu la carte
    setTimeout(function() {
        var attr = document.querySelector('#home-map-container .leaflet-control-attribution');
        if (attr && !attr.querySelector('.leaflet-attr-close')) {
            var closeBtn = document.createElement('button');
            closeBtn.className = 'leaflet-attr-close';
            closeBtn.innerHTML = '&times;';
            closeBtn.title = 'Masquer la légende';
            closeBtn.setAttribute('type', 'button');
            closeBtn.onclick = function() {
                attr.style.display = 'none';
            };
            attr.appendChild(closeBtn);
        }
    }, 2000);
});
</script>

    <!-- Wrapper HTMX pour la zone de recherche uniquement -->
    <div id="SearchUi-home-wrapper" hx-boost="true">

    <!-- Zone Principale : Résultats (Pleine Largeur car sidebar supprimée) -->
    <div class="container" style="padding-top: 0;">
            
            <!-- État de la Recherche (Déplacé dans le header via OOB) -->
            <!-- Placeholder vide pour structure -->

            <!-- Carte Leaflet (si activée) -->
             {% if CORE.callHook('map:is-enabled') %}
             <div id="home-map-container" hx-preserve="true" class="search-map-container">
                <div id="home-map" style="height: 100%; width: 100%;"></div>
                
                <!-- Contrôles de Couches (Sur la carte) -->
                <div class="search-map-controls">
                    <button type="button" onclick="window.HomeMapMinimal.setLayer('standard')" data-layer="standard" class="map-layer-btn search-map-layer-btn active" title="Carte standard">
                        <i class="fa-solid fa-map"></i>
                    </button>
                    <button type="button" onclick="window.HomeMapMinimal.setLayer('dark')" data-layer="dark" class="map-layer-btn search-map-layer-btn dark" title="Mode Nuit">
                        <i class="fa-solid fa-moon"></i>
                    </button>
                    <button type="button" onclick="window.HomeMapMinimal.setLayer('satellite')" data-layer="satellite" class="map-layer-btn search-map-layer-btn satellite" title="Vue Aérienne">
                        <i class="fa-solid fa-satellite"></i>
                    </button>
                    <!-- Bouton plein écran (mobile uniquement) -->
                    <button type="button" id="map-fullscreen-btn" class="map-layer-btn search-map-layer-btn map-fullscreen-btn mobile-only" title="Plein écran" onclick="toggleMapFullscreen()">
                        <i class="fa-solid fa-expand" id="map-fullscreen-icon"></i>
                    </button>
                </div>
            </div>
{% endif %}

            {# Inscription spécifique du bloc Blog entre la carte et le compteur de résultats #}
            {% for section in extraHomeSections %}
                {% if 'blog-latest-post' in section %}
                    <div class="searchui-blog-repositioned" style="margin: 20px 0;">
                        {{ section|raw }}
                    </div>
                {% endif %}
            {% endfor %}

            {% if pois %}
            <!-- Barre de résultats : séparateur entre carte et liste -->
            <div class="search-results-count-bar">
                <span class="count-bar-number">{{ filtered_results_count }}</span>
                <span class="count-bar-label">lieu{% if filtered_results_count > 1 %}x{% endif %} trouvé{% if filtered_results_count > 1 %}s{% endif %}</span>
                {% if query %}<span class="count-bar-query">pour « {{ query }} »</span>{% endif %}
            </div>

            <!-- Résultats ou Détail -->
            <div id="search-content-wrapper" style="position: relative;">
                
                <!-- Liste des Résultats -->
                <div id="pois-results-container" class="results-container">
                    <div id="pois-list-target" class="pois-list-items">
                        {% include 'plugin/SearchUi/template/partials/poi_list.tpl' %}
                    </div>
                </div>

                <!-- Bouton flottant Retour en haut -->
                <button id="back-to-top" class="floating-back-to-top" title="Retour en haut" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
                    <i class="fa-solid fa-arrow-up"></i>
                </button>
            </div>
<script>
    function initResultMaps() {
        if (!window.UniversalMap) return;
        
        document.querySelectorAll('.poi-minimap:not(.initialized)').forEach(function(el) {
            var lat = parseFloat(el.getAttribute('data-lat'));
            var lon = parseFloat(el.getAttribute('data-lon'));
            var name = el.getAttribute('data-name');
            var family = el.getAttribute('data-family') || 'other';
            var icon = el.getAttribute('data-icon') || 'location-dot';

            if (lat && lon) {
                var miniMap = new UniversalMap(el.id, {
                    lat: lat,
                    lon: lon,
                    zoom: 15,
                    markerFamily: family,
                    markerIcon: icon
                });
                miniMap.toggleLock(true);
                el.classList.add('initialized');
            }
        });
    }

    // Initialisation au chargement et après requêtes HTMX
    document.addEventListener('DOMContentLoaded', initResultMaps);
    document.addEventListener('htmx:afterSwap', function(evt) {
        if (evt.detail.target.id === 'pois-list-target' || evt.detail.elt.classList.contains('search-result-item')) {
            initResultMaps();
        }
    });

    // Gestion du bouton retour en haut
    window.addEventListener('scroll', function() {
        var btn = document.getElementById('back-to-top');
        if (btn) {
            if (window.scrollY > 500) {
                btn.classList.add('visible');
            } else {
                btn.classList.remove('visible');
            }
        }
    });
</script>
<script>
    (function() {
        var newPois = {{pois_json}};
        window.currentPois = newPois;
        if (window.HomeMapMinimal && typeof window.HomeMapMinimal.updatePois === 'function') {
            window.HomeMapMinimal.updatePois(newPois);
        }
    })();
</script>
                    
                {% else %}
                    <div class="search-empty-state">
                        <i class="fa-solid fa-search-minus search-empty-icon"></i>
                        <h3 class="search-empty-title">Aucun résultat pour cette recherche</h3>
                        <p style="color: #999;">Essayez d'élargir vos critères ou de supprimer certains filtres.</p>
                        <a href="{{SHOW.siteUrl}}/recherche" 
                           hx-get="/SearchUi" 
                           hx-target="#SearchUi-home-wrapper" 
                           hx-select="#SearchUi-home-wrapper" 
                           hx-swap="outerHTML"
                           hx-push-url="true"
                           hx-indicator="#loading-overlay"
                           class="search-empty-btn">
                            <i class="fa-solid fa-rotate-right"></i> Réinitialiser la recherche
                        </a>
                    </div>
                {% endif %}
            </div>

        <!-- Loading Overlay (Full Page) -->
        <div id="loading-overlay" class="htmx-indicator search-loading-overlay">
            <div style="text-align: center; color: #ff8c42;">
                <div class="loader-spinner"></div>
                <p style="font-weight: 800; font-size: 1.2rem; text-transform: uppercase;">Mise à jour...</p>
            </div>
        </div>
        <style>@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }</style>

    </div>
</section>

<script src="https://unpkg.com/htmx.org@1.9.10"></script>
{% if CORE.callHook('map:is-enabled') %}
    {{ CORE.callHook('map:load-assets') }}
    <script>
    // Injection des traductions AVANT le chargement de la carte
    window.familyTranslations = {{family_translations_json|default('{}')|raw}};
    </script>
    <script src="{{SHOW.siteUrl}}/plugin/SearchUi/assets/js/home-map-minimal.js?v=11"></script>
{% endif %}
 <script>
(function() {
    'use strict';
    
    // Flag global pour éviter les doubles initialisations si le script est re-executé
    if (window.searchUiScriptLoaded) return;
    window.searchUiScriptLoaded = true;
    window.searchUiGeolocApplied = false;

    console.log("SearchUi: Script Home Master chargé.");

    function initToggles() {
        console.log("SearchUi: Execution de initToggles()...");
        
        // 1. Bouton Filtres (Sidebar)
        const toggleBtn = document.getElementById('toggle-sidebar-btn');
        const filterBar = document.getElementById('search-filters-bar');
        if (toggleBtn && filterBar) {
            toggleBtn.onclick = function(e) {
                if (e) e.preventDefault();
                const isHidden = window.getComputedStyle(filterBar).display === 'none';
                filterBar.style.setProperty('display', isHidden ? 'flex' : 'none', 'important');
                this.classList.toggle('active', isHidden);
                this.style.background = isHidden ? '#ff8c42' : '#333';
            };
        }

        // 2. Bouton Carte (Passif)
        const toggleMapBtn = document.getElementById('toggle-map-btn');
        const mapCol = document.getElementById('home-map-container');
        
        if (toggleMapBtn && mapCol) {
            const syncMapUI = (forceState = null) => {
                let isVisible = forceState !== null ? forceState : (localStorage.getItem('searchUiMapVisible') === 'true');
                
                console.log("SearchUi: syncMapUI - isVisible=" + isVisible);
                mapCol.style.display = isVisible ? 'block' : 'none';
                toggleMapBtn.classList.toggle('active', isVisible);
                toggleMapBtn.style.background = isVisible ? '#ff8c42' : '#667eea';
                
                if (isVisible && window.HomeMapMinimal) {
                    window.HomeMapMinimal.initMap();
                    // Refresh progressif
                    [50, 300, 1000].forEach(delay => {
                        setTimeout(() => { if (window.HomeMapMinimal) window.HomeMapMinimal.invalidateSize(); }, delay);
                    });
                }
            };

            toggleMapBtn.onclick = function(e) {
                if (e) e.preventDefault();
                console.log("SearchUi: Clic sur Toggle Carte (LocalStorage)");
                const newState = !(localStorage.getItem('searchUiMapVisible') === 'true');
                localStorage.setItem('searchUiMapVisible', newState);
                syncMapUI(newState);
            };

            // Sync initial
            syncMapUI();
        }
    }

    // Écrit le cookie de géoloc lisible par PHP côté serveur
    function setGeolocCookie(lat, lon) {
        const val = parseFloat(lat).toFixed(6) + ',' + parseFloat(lon).toFixed(6);
        document.cookie = 'user_geoloc=' + val + '; path=/; max-age=86400; SameSite=Lax';
    }

    // Gestion de la géoloc
    function checkGeoloc() {
        const location = window.userLocation || JSON.parse(localStorage.getItem('userLocation'));
        if (!location || !location.lat) return;

        const latInp = document.getElementById('user-lat');
        const lonInp = document.getElementById('user-lon');
        const filterForm = document.getElementById('filter-form');
        
        if (!latInp || !lonInp || !filterForm) return;

        // On compare avec les valeurs actuelles pour éviter de refresh si rien n'a changé
        const currentLat = parseFloat(location.lat).toFixed(6);
        const currentLon = parseFloat(location.lon).toFixed(6);
        const existingLat = parseFloat(latInp.value || 0).toFixed(6);
        const existingLon = parseFloat(lonInp.value || 0).toFixed(6);

        // Toujours mettre à jour le cookie pour le prochain chargement côté PHP
        setGeolocCookie(currentLat, currentLon);

        // Si déjà appliqué dans cette session ET que les coordonnées sont identiques
        if (sessionStorage.getItem('sr_geoloc_applied') === 'true' && 
            currentLat === existingLat && currentLon === existingLon) {
            return;
        }

        console.log("SearchUi: Geoloc détectée, vérification des coordonnées...");
        
        if (window.HomeMapMinimal && window.HomeMapMinimal.updateUserPosition) {
            window.HomeMapMinimal.updateUserPosition(parseFloat(currentLat), parseFloat(currentLon));
        }
        
        sessionStorage.setItem('sr_geoloc_applied', 'true');
        
        // On ne trigger le submit QUE si les coordonnées ont réellement changé par rapport aux inputs
        if (currentLat !== existingLat || currentLon !== existingLon) {
            latInp.value = currentLat;
            lonInp.value = currentLon;
            
            if (typeof htmx !== 'undefined') {
                console.log("SearchUi: Refresh HTMX déclenché par nouvelle géoloc.");
                htmx.trigger(filterForm, 'submit');
            }
        }
    }

    // Radius Slider Visual Sync
    function initFilters() {
        const checkbox = document.getElementById('around-me-checkbox');
        const group = document.getElementById('radius-slider-group');
        const slider = document.getElementById('radius-slider');
        const valTxt = document.getElementById('radius-value');

        if (checkbox && group) {
            const updateState = () => {
                const isActive = checkbox.checked;
                group.style.opacity = isActive ? '1' : '0.5';
                group.style.pointerEvents = isActive ? 'auto' : 'none';
                
                if (window.HomeMapMinimal) {
                    if (isActive && window.userLocation) {
                        window.HomeMapMinimal.updateRadius(window.userLocation.lat, window.userLocation.lon, parseFloat(slider.value));
                    } else {
                        window.HomeMapMinimal.removeRadius();
                    }
                }
            };
            checkbox.addEventListener('change', updateState);
            updateState();
        }

        if (slider && valTxt) {
            slider.addEventListener('input', () => { 
                valTxt.textContent = slider.value; 
                if (checkbox.checked && window.HomeMapMinimal && window.userLocation) {
                    window.HomeMapMinimal.updateRadius(window.userLocation.lat, window.userLocation.lon, parseFloat(slider.value));
                }
            });
        }
    }

    // --- Lifecycle ---
    
    // Universal Minimap Init for Search Results
    function initResultMaps() {
        if (typeof UniversalMap === 'undefined') {
            setTimeout(initResultMaps, 500);
            return;
        }
        
        const minimaps = document.querySelectorAll('.poi-minimap.result-minimap:not([data-mapped="true"])');
        if (minimaps.length === 0) return;
        
        minimaps.forEach(function(el) {
            const lat = parseFloat(el.getAttribute('data-lat'));
            const lon = parseFloat(el.getAttribute('data-lon'));
            const family = el.getAttribute('data-family') || 'other';
            const icon = el.getAttribute('data-icon') || 'location-dot';

            if (lat && lon && !isNaN(lat) && !isNaN(lon)) {
                try {
                    // Safety: check if element was already processed
                    if (el.dataset.mapped === 'true' || el._leaflet_id) return;

                    if (!el.id) el.id = 'map-result-h-' + Math.random().toString(36).substr(2, 9);
                    
                    const uMap = new UniversalMap(el.id, {
                        lat: lat,
                        lon: lon,
                        zoom: 15,
                        editable: false,
                        markerFamily: family,
                        markerIcon: icon
                    });

                    if (uMap.map) {
                        uMap.toggleLock(true);
                        uMap.map.removeControl(uMap.map.zoomControl);
                        
                        // Handle mobile rendering delay
                        const refreshMap = () => {
                            if (uMap.map) {
                                uMap.map.invalidateSize();
                                uMap.map.setView([lat, lon], 15);
                            }
                        };
                        
                        requestAnimationFrame(() => {
                            setTimeout(refreshMap, 400); 
                            setTimeout(refreshMap, 1200); // Second pass for slower mobile connections/transitions
                        });
                    }
                    el.dataset.mapped = 'true';
                } catch (e) {
                    console.error('SearchUi: Error initializing result map:', e);
                }
            }
        });
    }

    // 1. Au chargement initial
    document.addEventListener('DOMContentLoaded', () => {
        window.HomeMapConfig = {
            markerPath: ("{{SHOW.siteUrl}}").replace(/\/$/, "") + "/theme/Lumiere/leaflet-marker.png"
        };
        initToggles();
        initFilters();
        initResultMaps();
        // Clear flag on fresh load to allow one geoloc update per session
        sessionStorage.removeItem('sr_geoloc_applied');
        
        if (!window._geolocInterval) {
            window._geolocInterval = setInterval(checkGeoloc, 3000);
        }

        // === AUTO-GÉOLOCALISATION VIA SERVICE GLOBAL ===
        const hasLatInUrl = (new URLSearchParams(window.location.search)).has('user_lat');
        const hasCachedLocation = !!localStorage.getItem('userLocation');

        // On écoute la mise à jour de position venant du service global (geolocation.js)
        window.addEventListener('user-location-updated', function(e) {
            console.log("SearchUi: Position reçue du service global.", e.detail);
            window.userLocation = e.detail;
            checkGeoloc();
        });

        // Si on a déjà une position en cache au chargement (sans attendre l'event)
        if (!hasLatInUrl && hasCachedLocation) {
            const cached = JSON.parse(localStorage.getItem('userLocation'));
            if (cached && cached.lat && cached.lon) {
                window.userLocation = cached;
                checkGeoloc();
            }
        }
    });

    // 2. Après chaque swap HTMX
    // Save filter bar state before swap so it persists
    document.addEventListener('htmx:beforeSwap', (evt) => {
        const filterBar = document.getElementById('search-filters-bar');
        if (filterBar) {
            window._filterBarWasVisible = (window.getComputedStyle(filterBar).display !== 'none');
        }
    });

    document.addEventListener('htmx:afterSwap', (evt) => {
        // On re-initialise si le wrapper ou la barre de statut a changé
        if (evt.detail.target.id === 'SearchUi-home-wrapper' || evt.detail.target.id === 'search-status-bar') {
            console.log("SearchUi: AfterSwap -> Re-init toggles & filters & maps");
            initToggles();
            initFilters();
            // Delay map init slightly to let results settle in DOM
            setTimeout(initResultMaps, 100); 

            // Restore filter bar visibility if it was open before the swap
            if (window._filterBarWasVisible) {
                const filterBar = document.getElementById('search-filters-bar');
                if (filterBar) {
                    filterBar.style.setProperty('display', 'flex', 'important');
                }
                const toggleBtn = document.getElementById('toggle-sidebar-btn');
                if (toggleBtn) {
                    toggleBtn.classList.add('active');
                    toggleBtn.style.background = '#ff8c42';
                }
            }
        }
    });

    // 3. Fallback htmx:load
    document.addEventListener('htmx:load', (evt) => {
        if (evt.target.querySelector && evt.target.querySelector('.poi-minimap')) {
            initResultMaps();
        }
    });

})();
</script>



