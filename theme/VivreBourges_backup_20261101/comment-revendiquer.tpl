<div class="revendiquer-page-container" style="max-width: 960px; margin: 40px auto; padding: 0 20px;">
    <!-- En-tête Hero -->
    <header style="text-align: center; margin-bottom: 45px;">
        <span style="display: inline-block; padding: 6px 16px; background: rgba(255, 140, 66, 0.12); color: #ff8c42; border-radius: 50px; font-weight: 700; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px;">
            <i class="fa-solid fa-store" style="margin-right: 6px;"></i> Espace Professionnels & Artisans
        </span>
        <h1 style="color: var(--text-color, #1e293b); font-size: 2.4rem; font-weight: 800; line-height: 1.25; margin-bottom: 15px;">
            Comment revendiquer votre fiche ?
        </h1>
        <p style="color: var(--text-muted, #64748b); font-size: 1.15rem; max-width: 680px; margin: 0 auto; line-height: 1.6;">
            Prenez gratuitement le contrôle de votre vitrine locale sur Vivre-Bourges pour informer vos clients, afficher vos horaires réels et valoriser votre savoir-faire.
        </p>
    </header>

    <!-- Carte Principale des Étapes -->
    <div style="background: var(--card-bg, #ffffff); border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.06); padding: 40px 30px; border: 1px solid var(--border-color, #e2e8f0); margin-bottom: 35px;">
        
        <!-- Étape 1 -->
        <div style="display: flex; gap: 24px; margin-bottom: 40px; align-items: flex-start;">
            <div style="flex-shrink: 0; width: 48px; height: 48px; background: #3b82f6; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; font-weight: 800; box-shadow: 0 4px 12px rgba(59,130,246,0.35);">
                1
            </div>
            <div style="flex-grow: 1;">
                <h3 style="color: var(--text-color, #1e293b); font-size: 1.35rem; font-weight: 700; margin-bottom: 8px;">
                    Recherchez votre établissement
                </h3>
                <p style="color: var(--text-muted, #475569); line-height: 1.6; margin-bottom: 15px;">
                    Utilisez le moteur de recherche pour retrouver votre commerce, cabinet, atelier ou restaurant. Tapez simplement son nom commercial ou votre adresse.
                </p>
                <div style="background: #f8fafc; border-radius: 12px; padding: 16px; border: 1px dashed #cbd5e1; display: flex; align-items: center; gap: 12px; color: #64748b; font-size: 0.95rem;">
                    <i class="fa-solid fa-magnifying-glass" style="color: #3b82f6; font-size: 1.2rem;"></i>
                    <span>Exemple : tapez « Boulangerie », « Pharmacie » ou le nom de votre enseigne sur la recherche.</span>
                </div>
            </div>
        </div>

        <!-- Séparateur -->
        <hr style="border: 0; border-top: 1px solid #f1f5f9; margin: 0 0 40px 0;">

        <!-- Étape 2 -->
        <div style="display: flex; gap: 24px; margin-bottom: 40px; align-items: flex-start;">
            <div style="flex-shrink: 0; width: 48px; height: 48px; background: #ff8c42; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; font-weight: 800; box-shadow: 0 4px 12px rgba(255,140,66,0.35);">
                2
            </div>
            <div style="flex-grow: 1;">
                <h3 style="color: var(--text-color, #1e293b); font-size: 1.35rem; font-weight: 700; margin-bottom: 8px;">
                    Cliquez sur « Propriétaire ? Revendiquez »
                </h3>
                <p style="color: var(--text-muted, #475569); line-height: 1.6; margin-bottom: 15px;">
                    Sur la page détaillée de votre fiche ou directement sur votre carte de résultat, un badge interactif vous permet de manifester votre qualité de propriétaire ou gérant.
                </p>
                <div style="display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; background: rgba(255,140,66,0.1); border: 1px solid rgba(255,140,66,0.3); border-radius: 8px; color: #e67e22; font-weight: 600; font-size: 0.95rem;">
                    <i class="fa-solid fa-hand-sparkles"></i> Propriétaire ? Revendiquer cette fiche
                </div>
            </div>
        </div>

        <!-- Séparateur -->
        <hr style="border: 0; border-top: 1px solid #f1f5f9; margin: 0 0 40px 0;">

        <!-- Étape 3 -->
        <div style="display: flex; gap: 24px; align-items: flex-start;">
            <div style="flex-shrink: 0; width: 48px; height: 48px; background: #10b981; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; font-weight: 800; box-shadow: 0 4px 12px rgba(16,185,129,0.35);">
                3
            </div>
            <div style="flex-grow: 1;">
                <h3 style="color: var(--text-color, #1e293b); font-size: 1.35rem; font-weight: 700; margin-bottom: 8px;">
                    Complétez votre fiche et validez votre gestion
                </h3>
                <p style="color: var(--text-muted, #475569); line-height: 1.6; margin-bottom: 15px;">
                    Après validation par l'équipe, accédez à votre espace dédié pour mettre à jour vos horaires d'ouverture réels, votre logo, vos photos de couverture, vos liens vers vos réseaux sociaux et vos offres spéciales.
                </p>
                <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-top: 10px;">
                    <span style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; background: #f0fdf4; border-radius: 6px; color: #166534; font-size: 0.85rem; font-weight: 600;">
                        <i class="fa-solid fa-check"></i> 100% Gratuit
                    </span>
                    <span style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; background: #f0fdf4; border-radius: 6px; color: #166534; font-size: 0.85rem; font-weight: 600;">
                        <i class="fa-solid fa-check"></i> Horaires en temps réel
                    </span>
                    <span style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; background: #f0fdf4; border-radius: 6px; color: #166534; font-size: 0.85rem; font-weight: 600;">
                        <i class="fa-solid fa-check"></i> Référencement local optimisé
                    </span>
                </div>
            </div>
        </div>

    </div>

    <!-- Blocs Alternatifs (Nouveau POI ou Contact) -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 40px;">
        <!-- Nouveau lieu -->
        <div style="background: #ffffff; border-radius: 16px; padding: 25px; border: 1px solid #e2e8f0; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(59,130,246,0.1); color: #3b82f6; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">
                    <i class="fa-solid fa-plus"></i>
                </div>
                <h4 style="margin: 0; color: #1e293b; font-size: 1.15rem; font-weight: 700;">Établissement non listé ?</h4>
            </div>
            <p style="color: #64748b; font-size: 0.95rem; line-height: 1.5; margin-bottom: 20px;">
                Si votre activité est récente et n'apparaît pas encore dans l'annuaire de Bourges, vous pouvez la déclarer en 2 minutes.
            </p>
            <a href="/PoiManager/propose" style="display: inline-block; width: 100%; text-align: center; padding: 10px 16px; background: #3b82f6; color: white; border-radius: 8px; font-weight: 600; text-decoration: none; transition: background 0.2s;">
                <i class="fa-solid fa-location-dot" style="margin-right: 6px;"></i> Proposer un nouveau lieu
            </a>
        </div>

        <!-- Contact Support -->
        <div style="background: #ffffff; border-radius: 16px; padding: 25px; border: 1px solid #e2e8f0; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(16,185,129,0.1); color: #10b981; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">
                    <i class="fa-solid fa-envelope"></i>
                </div>
                <h4 style="margin: 0; color: #1e293b; font-size: 1.15rem; font-weight: 700;">Besoin d'aide ?</h4>
            </div>
            <p style="color: #64748b; font-size: 0.95rem; line-height: 1.5; margin-bottom: 20px;">
                Une question sur la validation de votre fiche ou un besoin d'assistance ? Contactez directement l'équipe locale.
            </p>
            <a href="/contact" style="display: inline-block; width: 100%; text-align: center; padding: 10px 16px; background: #f1f5f9; color: #334155; border-radius: 8px; font-weight: 600; text-decoration: none; transition: background 0.2s;">
                <i class="fa-solid fa-headset" style="margin-right: 6px;"></i> Contacter l'équipe
            </a>
        </div>
    </div>

    <!-- Bouton CTA Principal -->
    <div style="text-align: center; margin-top: 30px;">
        <a href="/SearchUi" style="display: inline-flex; align-items: center; gap: 10px; padding: 14px 32px; background: #ff8c42; color: white; font-size: 1.1rem; font-weight: 700; border-radius: 50px; text-decoration: none; box-shadow: 0 6px 20px rgba(255,140,66,0.35); transition: transform 0.2s;">
            <i class="fa-solid fa-magnifying-glass"></i> Rechercher mon établissement maintenant
        </a>
    </div>
</div>
