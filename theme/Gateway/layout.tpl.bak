<!DOCTYPE html>
<html lang="{{lang.getLocale}}">
	<head>
		{% HOOK.frontHead %}
		<meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
		<title>{{SHOW.titleTag}}</title>
		<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"/>
		<meta name="description" content="{{SHOW.metaDescriptionTag}}"/>
		<link rel="icon" href="{{SHOW.themeIcon}}"/>
		<base href="{{SHOW.siteUrl}}/">
		{{SHOW.linkTags}}
		{{SHOW.scriptTags}}
		{{SHOW.showMetas}}
		{% HOOK.endFrontHead("") %}
		<link rel="stylesheet" href="theme/Gateway/style.css">
	</head>
	<body class="theme-gateway {% if CORE.getPluginToCall == "docs" %}docs-page{% endif %} {% if CORE.getPluginToCall == "page" or CORE.getPluginToCall == "" %}page-module{% endif %} plugin-{{CORE.getPluginToCall}}">
		<div id="body-background"></div>
		<div id="container">
			<header id="header">
				<nav id="header-content" class="header-inner">
					<div class="header-brand">
						<a href="{{SHOW.siteUrl}}" class="brand-logo">
							{% if CORE.getConfigVal("siteLogo") != "" %}
								<img class="site-logo" src="{{SHOW.siteLogoUrl}}" alt="{{SHOW.siteName}}" />
							{% else %}
								<span id="siteName">{{SHOW.siteName}}</span>
							{% endif %}
						</a>
					</div>
					
					<div class="header-controls">
                        <!-- Main Navigation -->
						<ul id="navigation" class="desktop-nav">
							{{SHOW.mainNavigation}}
							{% HOOK.endMainNavigation("") %}
						</ul>

                        <!-- Smart Search (Dynamic Visibility) -->
                        {% HOOK.layout:header-search %}

                        <!-- Auth Links -->
                        <div class="auth-controls">
                            {% if IS_LOGGED %}
                                <a href="{% HOOK.user:profile-url('') %}" class="btn-auth btn-profile">{{Lang.core-profile}}</a>
                                <a href="{% HOOK.user:logout-url('') %}" class="btn-auth btn-logout"><i class="fa fa-sign-out"></i></a>
                            {% else %}
                                <a href="{% HOOK.user:login-url('') %}" class="btn-auth btn-login">{{Lang.core-connection}}</a>
                            {% endif %}
                        </div>

                        <!-- Mobile Toggle -->
						<input type="checkbox" id="nav_toggle" class="nav-toggle" aria-hidden="true" />
						<label for="nav_toggle" id="mobile_menu_btn"><i class="fa-solid fa-bars"></i></label>
					</div>
				</nav>
			</header>

            <!-- Hero Zone: Orchestrated Content Area -->
            <section id="hero-wrapper">
                {% HOOK.layout:hero-zone %}
            </section>

			<div id="alert-msg">
				{{SHOW.displayMsg}}
			</div>

			<main id="body">
                <!-- Page Title Logic -->
				{% IF CORE.getConfigVal(hideTitles) == 0 and not HIDE_PAGE_TITLE %}
					<div class="page-header">
						{% if PAGE_TITLE %}
							<h1>{{PAGE_TITLE}}</h1>
						{% else %}
							{{SHOW.mainTitle}}
						{% endif %}
					</div>
				{% ENDIF %}

				<div id="body-page">
					<div id="content" class="plugin-container">
						{{CONTENT}}
					</div>
					{{show.displayPublicSidebar()}}
				</div>
			</main>

			<footer id="footer">
				<div class="footer-inner">
					{% HOOK.footer %}
					<div class="footer-links">
                        {{Lang.site-theme}} Gateway
					</div>
					{% HOOK.endFooter %}
				</div>
			</footer>
		</div>
		{% HOOK.endFrontBody %}
	</body>
</html>
