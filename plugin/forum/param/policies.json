{
    "forum:admin": {
        "logic": "OR",
        "conditions": [
            {
                "provider": "role",
                "type": "role",
                "value": "ADM"
            }
        ]
    },
    "forum:moderate": {
        "logic": "OR",
        "conditions": [
            {
                "provider": "role",
                "type": "role",
                "value": "ADM"
            },
            {
                "provider": "role",
                "type": "role",
                "value": "moderator"
            }
        ]
    },
    "forum:post": {
        "logic": "OR",
        "conditions": [
            {
                "provider": "auth",
                "type": "is_logged",
                "value": true
            }
        ]
    }
}
