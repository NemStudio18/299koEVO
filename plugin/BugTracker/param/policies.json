{
    "bugtracker:admin": {
        "logic": "OR",
        "conditions": [
            {
                "provider": "role",
                "type": "role",
                "value": "ADM"
            },
            {
                "provider": "role",
                "type": "role",
                "value": "developer"
            }
        ]
    },
    "bugtracker:report": {
        "logic": "OR",
        "conditions": [
            {
                "provider": "auth",
                "type": "is_logged",
                "value": true
            },
            {
                "provider": "auth",
                "type": "is_logged",
                "value": false
            }
        ]
    },
    "bugtracker:comment": {
        "logic": "AND",
        "conditions": [
            {
                "provider": "auth",
                "type": "is_logged",
                "value": true
            }
        ]
    }
}
