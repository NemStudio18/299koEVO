{
    "agenda:admin": {
        "logic": "OR",
        "conditions": [
            {
                "type": "role",
                "value": "admin"
            },
            {
                "type": "meta",
                "value": "is_owner"
            }
        ]
    },
    "agenda:post": {
        "logic": "OR",
        "conditions": [
            {
                "type": "role",
                "value": "admin"
            },
            {
                "type": "auth",
                "value": true
            }
        ]
    }
}