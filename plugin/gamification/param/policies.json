{
    "gamification:admin": {
        "logic": "OR",
        "conditions": [
            {
                "provider": "role",
                "type": "role",
                "value": "ADM"
            }
        ]
    },
    "user:progression:view": {
        "logic": "AND",
        "conditions": [
            {
                "provider": "auth",
                "type": "is_logged",
                "value": true
            }
        ]
    }
}
