<!-- PWA Install Banner -->
<div id="pwa-install-banner" class="pwa-install-banner hidden">
    <div class="pwa-banner-content">
        <i class="fa-solid fa-mobile-screen-button"></i>
        <div class="pwa-banner-text">
            <strong>{{installLabel}}</strong>
            <span>Installez-la sur votre écran d'accueil pour un accès rapide.</span>
        </div>
    </div>
    <div class="pwa-banner-actions">
        <button id="pwa-install-confirm" class="button small primary">Installer</button>
        <button id="pwa-install-later" class="button small">Plus tard</button>
    </div>
</div>
