{
    "auth:admin": {
        "logic": "OR",
        "conditions": [
            {
                "provider": "role",
                "type": "role",
                "value": "ADM"
            }
        ]
    },
    "auth:personal": {
        "logic": "OR",
        "conditions": [
            {
                "provider": "auth",
                "type": "is_logged",
                "value": true
            }
        ]
    }
}