{
    "claim:access": {
        "logic": "OR",
        "conditions": [
            {
                "provider": "auth",
                "type": "is_logged",
                "value": true
            }
        ]
    },
    "claim:admin": {
        "logic": "OR",
        "conditions": [
            {
                "provider": "role",
                "type": "role",
                "value": "ADM"
            },
            {
                "provider": "role",
                "type": "role",
                "value": "admin"
            }
        ]
    },
    "user:claims:view": {
        "logic": "OR",
        "conditions": [
            {
                "type": "auth",
                "value": true
            }
        ]
    },
    "poi:claim": {
        "logic": "OR",
        "conditions": [
            {
                "type": "auth",
                "value": true
            }
        ]
    }
}